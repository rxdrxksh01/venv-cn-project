# ============================================================
#  TEAM SETTINGS — the ONLY file you need to edit.
#  Fill it in once (on Mac 1), then give the same copy to all 4 Macs.
#  Get each Mac's IP by running:  ./common/netinfo.sh
# ============================================================

# Your team's private domain (must end in .test — never .local)
TEAM=team1
DOMAIN=team1.test

# Private IPv4 address of each Mac on the shared Wi-Fi/LAN
MAC1_IP=10.7.6.171     # Person 1 — Primary DNS (dnsmasq) + Test Client
MAC2_IP=10.7.20.28     # Person 2 — Edge: nginx reverse proxy + load balancer + TLS
MAC3_IP=10.7.20.243     # Person 3 — Backend A (port 3001)
MAC4_IP=10.7.8.144     # Person 4 — Backend B (port 3002) + Test Client

# Backend ports (fixed, as the project asks)
PORT_A=3001
PORT_B=3002

# macOS network service name (check with: networksetup -listallnetworkservices)
WIFI_SERVICE="Wi-Fi"
