# ============================================================
#  NATIVE TEAM SETTINGS — keep the same addresses on all available Macs.
#  Docker also has per-host settings in docker-dns/.env.
#  After DHCP changes, use classroom-prepare.py for the appropriate Mac role.
#  Get each Mac's IP by running:  ./common/netinfo.sh
# ============================================================

# Your team's private domain (must end in .test — never .local)
TEAM=team1
DOMAIN=team1.test

# Private IPv4 address of each Mac on the shared Wi-Fi/LAN
MAC1_IP=10.7.31.231    # Primary DNS container — now hosted on Anshuman's Mac
MAC2_IP=10.7.31.231    # Anshuman — Edge: nginx reverse proxy + load balancer + TLS
MAC3_IP=10.7.1.112     # Bineet — Backend A (port 3001)
MAC4_IP=10.7.2.240     # Vridhi — Backend B (port 3002) + Test Client

# Backend ports (fixed, as the project asks)
PORT_A=3001
PORT_B=3002

# macOS network service name (check with: networksetup -listallnetworkservices)
WIFI_SERVICE="Wi-Fi"
