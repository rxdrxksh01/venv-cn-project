# EXAMPLE ADDRESSES ONLY. Replace with today's LAN IPs before starting.
# Primary: run on Anshuman's Mac. Backup: copy this folder to Vridhi's Mac
# and set DNS_BIND_IP to HER LAN IP; keep EDGE_IP identical on both.
DNS_BIND_IP=192.168.50.10
DNS_PORT=53
EDGE_IP=192.168.50.10
DNS_TTL=30
# Use a reachable upstream resolver (e.g. the Wi-Fi's original DNS server).
UPSTREAM_DNS=1.1.1.1
# Separate record ttl-demo.team1.test: change this without breaking app/api.
# Leave empty to use EDGE_IP initially.
TTL_TARGET_IP=
